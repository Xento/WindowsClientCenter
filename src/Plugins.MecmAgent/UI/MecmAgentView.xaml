  Presentation and action layout adapted from SCCM Client Center by Roger
  Zander and contributors, commit aff9974590d39173e56201f94cd27b080f6552eb.
  SPDX-License-Identifier: MS-PL
-->
<UserControl x:Class="WindowsClientCenter.Plugins.MecmAgent.UI.MecmAgentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:ui="clr-namespace:WindowsClientCenter.Plugins.MecmAgent.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <ui:MecmIconConverter x:Key="MecmIconConverter" />

        <Style TargetType="Button" BasedOn="{StaticResource AppCommandButtonStyle}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource AppCommandCheckBoxStyle}" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGridStyle}">
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style x:Key="StatusTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource AppReadOnlyTextBoxStyle}" />

        <Style x:Key="ReadOnlyCenteredCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="OverviewCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F9FD" />
            <Setter Property="BorderBrush" Value="#D5E0EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style x:Key="OverviewSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="Foreground" Value="#17324D" />
        </Style>

        <Style x:Key="WorkloadTileBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="MinWidth" Value="220" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Visibility="{Binding IsOverviewSection, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE72C;" Content="Reload Overview" Width="160" Command="{Binding RefreshCurrentSectionCommand}" />
                    <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE895;" Content="Request Policy" Width="150" IsEnabled="{Binding CanRunOverviewActions}" CommandParameter="RequestMachinePolicy" Click="OverviewActionButton_OnClick" />
                    <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE8EF;" Content="Evaluate Policy" Width="150" IsEnabled="{Binding CanRunOverviewActions}" CommandParameter="EvaluateMachinePolicy" Click="OverviewActionButton_OnClick" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE7C3;" Content="Heartbeat" Width="130" IsEnabled="{Binding CanRunOverviewActions}" CommandParameter="TriggerHeartbeatDiscovery" Click="OverviewActionButton_OnClick" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE9D9;" Content="Hardware Inventory" Width="175" IsEnabled="{Binding CanRunOverviewActions}" CommandParameter="TriggerHardwareInventory" Click="OverviewActionButton_OnClick" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8FD;" Content="Software Inventory" Width="175" IsEnabled="{Binding CanRunOverviewActions}" CommandParameter="TriggerSoftwareInventory" Click="OverviewActionButton_OnClick" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE7BA;" Content="Run CCMEval" Width="145" IsEnabled="{Binding CanRunOverviewActions}" CommandParameter="RunCcmeval" Click="OverviewActionButton_OnClick" />
                </WrapPanel>

                <WrapPanel>
                    <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE877;" Content="Restart SMS Agent Host" Width="200" IsEnabled="{Binding CanRunOverviewActions}" CommandParameter="RestartCcmExec" Click="DisruptiveOverviewActionButton_OnClick" />
                    <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE72C;" Content="Reset Policy" Width="140" IsEnabled="{Binding CanRunOverviewActions}" CommandParameter="ResetPolicySoft" Click="DisruptiveOverviewActionButton_OnClick" />
                    <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE777;" Content="Hard Reset Policy" Width="165" IsEnabled="{Binding CanRunOverviewActions}" CommandParameter="ResetPolicyHard" Click="DisruptiveOverviewActionButton_OnClick" />
                    <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE90F;" Content="Repair Client" Width="145" IsEnabled="{Binding CanRunOverviewActions}" CommandParameter="RepairClient" Click="DisruptiveOverviewActionButton_OnClick" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="PolicyAgent.log" Width="150" Command="{Binding OpenPolicyAgentLogCommand}" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="InventoryAgent.log" Width="165" Command="{Binding OpenInventoryAgentLogCommand}" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="CoManagementHandler.log" Width="210" Command="{Binding OpenCoManagementHandlerLogCommand}" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="LocationServices.log" Width="180" Command="{Binding OpenLocationServicesLogCommand}" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="ClientIDManagerStartup.log" Width="220" Command="{Binding OpenClientIdManagerStartupLogCommand}" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="CcmEval.log" Width="140" Command="{Binding OpenCcmEvalLogCommand}" />
                </WrapPanel>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding IsApplicationsSection, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel Margin="0,0,0,10">
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE72C;" Content="Reload Applications" Width="170" Command="{Binding RefreshCurrentSectionCommand}" />
                <Button x:Name="EvaluateApplicationsButton"
                        Style="{StaticResource AppPrimaryIconTextButtonStyle}"
                        Tag="&#xE8EF;"
                        Content="Evaluate Apps"
                        Width="140"
                        Click="EvaluateApplicationsButton_OnClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Application manager user policy action"
                                      Command="{Binding TriggerUserApplicationPolicyCommand}" />
                            <MenuItem Header="Application manager machine policy action"
                                      Command="{Binding TriggerMachineApplicationPolicyCommand}" />
                            <MenuItem Header="Application manager global evaluation action"
                                      Command="{Binding TriggerGlobalApplicationEvaluationCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <CheckBox Content="Hide non UserUIExperience apps"
                          Margin="0,2,16,8"
                          VerticalAlignment="Center"
                          IsChecked="{Binding HideNonUserUiExperienceApps, Mode=TwoWay}" />
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="AppEnforce.log" Width="140" Command="{Binding OpenAppEnforceLogCommand}" />
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="AppDiscovery.log" Width="150" Command="{Binding OpenAppDiscoveryLogCommand}" />
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="AppIntentEval.log" Width="150" Command="{Binding OpenAppIntentEvalLogCommand}" />
            </WrapPanel>
        </Grid>

        <Grid Visibility="{Binding IsPendingUpdatesSection, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel Margin="0,0,0,10">
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE72C;" Content="Reload Updates" Width="150" Command="{Binding RefreshCurrentSectionCommand}" />
                <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE898;" Content="Install all mandatory" Width="180" Command="{Binding InstallAllMandatoryUpdatesCommand}" />
                <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE898;" Content="Install all" Width="130" Command="{Binding InstallAllApprovedUpdatesCommand}" />
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="UpdatesDeployment.log" Width="180" Command="{Binding OpenUpdatesDeploymentLogCommand}" />
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="WUAHandler.log" Width="140" Command="{Binding OpenWuaHandlerLogCommand}" />
            </WrapPanel>
        </Grid>

        <Grid Visibility="{Binding IsAllUpdatesSection, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel Margin="0,0,0,10">
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE72C;" Content="Reload Updates" Width="150" Command="{Binding RefreshCurrentSectionCommand}" />
                <CheckBox Content="Show missing updates"
                          Margin="0,2,12,8"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowMissingUpdatesOnly, Mode=TwoWay}" />
                <CheckBox Content="Hide duplicates"
                          Margin="0,2,16,8"
                          VerticalAlignment="Center"
                          IsChecked="{Binding HideDuplicateUpdates, Mode=TwoWay}" />
                <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE898;" Content="Install all required" Width="170" Command="{Binding InstallAllApprovedUpdatesCommand}" />
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="UpdatesDeployment.log" Width="180" Command="{Binding OpenUpdatesDeploymentLogCommand}" />
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="WUAHandler.log" Width="140" Command="{Binding OpenWuaHandlerLogCommand}" />
            </WrapPanel>
        </Grid>

        <Grid Visibility="{Binding IsPackagesSection, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel Margin="0,0,0,10">
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE72C;" Content="Reload Packages" Width="160" Command="{Binding RefreshCurrentSectionCommand}" />
                <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE768;" Content="Run Package" Width="145" Command="{Binding ExecuteSelectedPackagesCommand}" />
            </WrapPanel>
        </Grid>

        <Grid Visibility="{Binding IsDcmBaselinesSection, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel Margin="0,0,0,10">
                <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE72C;" Content="Reload Baselines" Width="165" Command="{Binding RefreshCurrentSectionCommand}" />
                <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE8EF;" Content="Evaluate Baseline" Width="170" Command="{Binding EvaluateSelectedBaselineCommand}" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer Visibility="{Binding IsOverviewSection, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource OverviewCardBorderStyle}"
                            Visibility="{Binding HasOverviewWarnings, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,10"
                            Background="#FFF7E8"
                            BorderBrush="#E8C66A">
                        <StackPanel>
                            <TextBlock Text="Warnings"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OverviewWarningsText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <primitives:UniformGrid Columns="5">
                        <Border Style="{StaticResource OverviewCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Client Version" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding OverviewClientVersionText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OverviewCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Assigned Site" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding OverviewAssignedSiteText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OverviewCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Management Point" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding OverviewManagementPointText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OverviewCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Reboot Pending" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding OverviewRebootPendingText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource OverviewCardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Co-Management" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding OverviewCoManagementStateText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </primitives:UniformGrid>

                    <TextBlock Style="{StaticResource OverviewSectionHeaderStyle}" Text="Recent Activity" />
                    <DataGrid ItemsSource="{Binding VisibleOverviewActivities}"
                              Height="220"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Activity" Binding="{Binding Name}" Width="170" />
                            <DataGridTextColumn Header="State" Binding="{Binding StatusText}" Width="95" />
                            <DataGridTextColumn Header="Level" Binding="{Binding StatusLevel}" Width="85" />
                            <DataGridTextColumn Header="Started" Binding="{Binding StartedDisplay}" Width="150" />
                            <DataGridTextColumn Header="Reported" Binding="{Binding ReportedDisplay}" Width="150" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource OverviewSectionHeaderStyle}" Text="Co-Management Workloads" />
                    <ItemsControl ItemsSource="{Binding VisibleOverviewWorkloads}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WorkloadTileBorderStyle}"
                                        Background="{Binding TileBackground}"
                                        BorderBrush="{Binding TileBorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#17324D"
                                                   TextWrapping="Wrap" />
                                        <Border HorizontalAlignment="Left"
                                                Margin="0,12,0,0"
                                                Padding="10,4"
                                                CornerRadius="12"
                                                Background="{Binding BadgeBackground}">
                                            <TextBlock Text="{Binding AuthorityDisplay}"
                                                       Foreground="{Binding BadgeForeground}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource OverviewSectionHeaderStyle}" Text="Agent Components" />
                    <DataGrid ItemsSource="{Binding VisibleOverviewComponents}"
                              Height="220"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="220" />
                            <DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
                            <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledDisplay}" Width="90" />
                            <DataGridTextColumn Header="Level" Binding="{Binding StatusLevel}" Width="85" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource OverviewSectionHeaderStyle}" Text="Relevant Services" />
                    <DataGrid ItemsSource="{Binding VisibleOverviewServices}"
                              Height="220"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding Name}" Width="120" />
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="220" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                            <DataGridTextColumn Header="Start Mode" Binding="{Binding StartMode}" Width="95" />
                            <DataGridTextColumn Header="Level" Binding="{Binding StatusLevel}" Width="85" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource OverviewSectionHeaderStyle}" Text="Health Checks" />
                    <DataGrid ItemsSource="{Binding VisibleOverviewHealthChecks}"
                              Height="220"
                              Margin="0,0,0,6"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="State" Binding="{Binding StatusText}" Width="120" />
                            <DataGridTextColumn Header="Level" Binding="{Binding StatusLevel}" Width="85" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <DataGrid x:Name="ApplicationsGrid"
                      Visibility="{Binding IsApplicationsSection, Converter={StaticResource BoolToVisibilityConverter}}"
                      ItemsSource="{Binding VisibleApplications}"
                      SelectedItem="{Binding SelectedApplication, Mode=TwoWay}"
                      SelectionMode="Extended"
                      PreviewMouseRightButtonDown="ApplicationsGrid_OnPreviewMouseRightButtonDown"
                      SelectionChanged="ApplicationsGrid_OnSelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Install"
                                  Command="{Binding InstallApplicationsCommand}"
                                  ToolTip="{Binding InstallApplicationsCommandTooltip}"
                                  ToolTipService.ShowOnDisabled="True" />
                        <MenuItem Header="Repair"
                                  Command="{Binding RepairApplicationsCommand}"
                                  ToolTip="{Binding RepairApplicationsCommandTooltip}"
                                  ToolTipService.ShowOnDisabled="True" />
                        <MenuItem Header="Uninstall"
                                  Command="{Binding UninstallApplicationsCommand}"
                                  ToolTip="{Binding UninstallApplicationsCommandTooltip}"
                                  ToolTipService.ShowOnDisabled="True" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="32">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="24" Height="24">
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding Icon, Converter={StaticResource MecmIconConverter}}"
                                           Width="24"
                                           Height="24"
                                           Stretch="Uniform" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="UI"
                                            Binding="{Binding UserUiExperience, Mode=OneWay}"
                                            Width="Auto"
                                            ElementStyle="{StaticResource ReadOnlyCenteredCheckBoxStyle}" />
                    <DataGridCheckBoxColumn Header="Simulate"
                                            Binding="{Binding IsPreflightOnly, Mode=OneWay}"
                                            Width="Auto"
                                            ElementStyle="{StaticResource ReadOnlyCenteredCheckBoxStyle}" />
                    <DataGridTemplateColumn Header="Target" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TargetIconGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto" />
                    <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="Auto" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="Auto" />
                    <DataGridTextColumn Header="ErrorCode" Binding="{Binding ErrorCodeDisplay}" Width="Auto" />
                    <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="Auto" />
                    <DataGridTextColumn Header="InstallState" Binding="{Binding InstallState}" Width="Auto" />
                    <DataGridTextColumn Header="InstallTime" Binding="{Binding InstallTimeDisplay}" Width="Auto" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="PendingUpdatesGrid"
                      Visibility="{Binding IsPendingUpdatesSection, Converter={StaticResource BoolToVisibilityConverter}}"
                      ItemsSource="{Binding VisiblePendingUpdates}"
                      SelectedItem="{Binding SelectedPendingUpdate, Mode=TwoWay}"
                      SelectionMode="Extended"
                      SelectionChanged="PendingUpdatesGrid_OnSelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Install" Command="{Binding InstallSelectedPendingUpdatesCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Evaluation State" Binding="{Binding EvaluationStateText}" Width="170" />
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="120" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260" />
                    <DataGridTextColumn Header="Deadline" Binding="{Binding DeadlineDisplay}" Width="145" />
                    <DataGridTextColumn Header="% Complete" Binding="{Binding PercentCompleteDisplay}" Width="92" />
                    <DataGridTextColumn Header="ErrorCode" Binding="{Binding ErrorCodeDisplay}" Width="96" />
                    <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="210" />
                    <DataGridTextColumn Header="Article ID" Binding="{Binding ArticleId}" Width="110" />
                    <DataGridTextColumn Header="Bulletin ID" Binding="{Binding BulletinId}" Width="100" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Visibility="{Binding IsAllUpdatesSection, Converter={StaticResource BoolToVisibilityConverter}}"
                      ItemsSource="{Binding VisibleAllUpdates}"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Article" Binding="{Binding Article}" Width="110" />
                    <DataGridTextColumn Header="Bulletin" Binding="{Binding Bulletin}" Width="100" />
                    <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="80" />
                    <DataGridTextColumn Header="Revision" Binding="{Binding RevisionNumber}" Width="70" />
                    <DataGridTextColumn Header="Scan Time" Binding="{Binding ScanTimeDisplay}" Width="145" />
                    <DataGridTextColumn Header="Source Version" Binding="{Binding SourceVersion}" Width="90" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="PackagesGrid"
                      Visibility="{Binding IsPackagesSection, Converter={StaticResource BoolToVisibilityConverter}}"
                      ItemsSource="{Binding VisiblePackages}"
                      SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                      SelectionMode="Extended"
                      SelectionChanged="PackagesGrid_OnSelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Run package" Command="{Binding ExecuteSelectedPackagesCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Package" Binding="{Binding PackageName}" Width="190" />
                    <DataGridTextColumn Header="Program" Binding="{Binding ProgramName}" Width="160" />
                    <DataGridTextColumn Header="Package ID" Binding="{Binding PackageId}" Width="110" />
                    <DataGridTextColumn Header="Advertisement ID" Binding="{Binding AdvertisementId}" Width="120" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80" />
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="110" />
                    <DataGridCheckBoxColumn Header="Mandatory"
                                            Binding="{Binding IsMandatory, Mode=OneWay}"
                                            Width="Auto"
                                            ElementStyle="{StaticResource ReadOnlyCenteredCheckBoxStyle}" />
                    <DataGridCheckBoxColumn Header="User Input"
                                            Binding="{Binding RequiresUserInput, Mode=OneWay}"
                                            Width="Auto"
                                            ElementStyle="{StaticResource ReadOnlyCenteredCheckBoxStyle}" />
                    <DataGridTextColumn Header="Availability" Binding="{Binding LastRunStatus}" Width="100" />
                    <DataGridTextColumn Header="Repeat Run" Binding="{Binding RepeatRunBehavior}" Width="140" />
                    <DataGridTextColumn Header="Available From" Binding="{Binding AvailableFromDisplay}" Width="145" />
                    <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresDisplay}" Width="145" />
                    <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Visibility="{Binding IsDcmBaselinesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="BaselinesGrid"
                          ItemsSource="{Binding VisibleBaselines}"
                          SelectedItem="{Binding SelectedBaseline, Mode=TwoWay}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Baseline" Binding="{Binding DisplayName}" Width="220" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70" />
                        <DataGridTextColumn Header="Target" Binding="{Binding TargetDisplay}" Width="75" />
                        <DataGridTextColumn Header="Compliance" Binding="{Binding ComplianceStateDisplay}" Width="110" />
                        <DataGridTextColumn Header="Compliance State" Binding="{Binding LastComplianceStatusDisplay}" Width="115" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="80" />
                        <DataGridTextColumn Header="Last Eval" Binding="{Binding LastEvalTimeDisplay}" Width="145" />
                        <DataGridTextColumn Header="Summary" Binding="{Binding ComplianceDetailsSummary}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1"
                              Height="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#D5E0EC" />

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding VisibleBaselineConfigItems}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Config Item" Binding="{Binding Name}" Width="190" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80" />
                        <DataGridCheckBoxColumn Header="Compliant"
                                                Binding="{Binding Compliant, Mode=OneWay}"
                                                Width="Auto"
                                                ElementStyle="{StaticResource ReadOnlyCenteredCheckBoxStyle}" />
                        <DataGridCheckBoxColumn Header="Detected"
                                                Binding="{Binding Detected, Mode=OneWay}"
                                                Width="Auto"
                                                ElementStyle="{StaticResource ReadOnlyCenteredCheckBoxStyle}" />
                        <DataGridCheckBoxColumn Header="Applicable"
                                                Binding="{Binding Applicable, Mode=OneWay}"
                                                Width="Auto"
                                                ElementStyle="{StaticResource ReadOnlyCenteredCheckBoxStyle}" />
                        <DataGridTextColumn Header="Constraint" Binding="{Binding ConstraintViolation}" Width="180" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <TextBox Grid.Row="2"
                 Margin="0,10,0,0"
                 Text="{Binding Status}"
                 Style="{StaticResource StatusTextBoxStyle}" />
    </Grid>
</UserControl>
