<UserControl x:Class="WindowsClientCenter.Plugins.WindowsUpdateAgent.UI.WindowsUpdateAgentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="StatusBarBg" Color="#EEF3F9" />

        <Style TargetType="Button" BasedOn="{StaticResource AppCommandButtonStyle}">
            <Setter Property="MinWidth" Value="145" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource AppCommandCheckBoxStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource AppCommandComboBoxStyle}" />
        <Style TargetType="GroupBox" BasedOn="{StaticResource AppGroupBoxStyle}" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGridStyle}">
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
        </Style>

        <Style x:Key="UpdateStateIconStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Text" Value="✖" />
            <Setter Property="Foreground" Value="#C42B1C" />
        </Style>

        <Style x:Key="ResolvedCodeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0B5CAD" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource AppShellOuterBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AppShellHeaderBorderStyle}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Windows Update Agent" Style="{StaticResource AppShellHeaderTitleTextStyle}" />
                        <TextBlock Text="Client operations and update diagnostics." Style="{StaticResource AppShellHeaderSubtitleTextStyle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource AppShellCommandBarBorderStyle}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSectionIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE721;" Content="Start Update Scan" Command="{Binding StartUpdateScanCommand}" />
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE777;" Content="Restart Update Service" Command="{Binding RestartUpdateServiceCommand}" />
                        <Button Style="{StaticResource AppDangerIconTextButtonStyle}" Tag="&#xE74D;" Content="Reset Update Cache" Command="{Binding ResetUpdateCacheCommand}" />
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8B7;" Content="Load Available Updates" Command="{Binding LoadAvailableUpdatesCommand}" />
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE81C;" Content="Load Update History" Command="{Binding LoadUpdateHistoryCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSectionIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8B7;" Content="Load Available Updates" Command="{Binding LoadAvailableUpdatesCommand}" />
                        <Button Content="Install Selected Updates"
                                Tag="&#xE898;"
                                Command="{Binding InstallSelectedUpdatesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AppPrimaryIconTextButtonStyle}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInstallTaskRunning}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE777;" Content="Restart Update Service" Command="{Binding RestartUpdateServiceCommand}" />
                        <Button Style="{StaticResource AppDangerIconTextButtonStyle}" Tag="&#xE74D;" Content="Reset Update Cache" Command="{Binding ResetUpdateCacheCommand}" />
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE72C;" Content="Refresh Install Status" Command="{Binding RefreshInstallTaskStatusCommand}" />
                        <StackPanel Margin="8,0,8,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="API" FontWeight="Bold" />
                            <ComboBox Width="110"
                                      ItemsSource="{Binding UpdateApiOptions}"
                                      SelectedItem="{Binding SelectedUpdateApi, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedUpdateApi}" Value="COM">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <CheckBox Margin="0,5,8,0"
                                      VerticalAlignment="Center"
                                      Content="Use last scan cache"
                                      IsChecked="{Binding UseCachedAvailableUpdates, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedUpdateApi}" Value="WinRT">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <CheckBox Margin="0,5,8,0"
                                      VerticalAlignment="Center"
                                      Content="WinRT install approval task (experimental)"
                                      IsChecked="{Binding UseWinRtInstallScript, Mode=TwoWay}" />
                        </StackPanel>

                        <CheckBox Margin="0,5,8,0"
                                  VerticalAlignment="Center"
                                  Content="Async install script (experimental)"
                                  IsChecked="{Binding UseAsyncInstallScript, Mode=TwoWay}" />
                        <CheckBox Margin="0,5,8,0"
                                  VerticalAlignment="Center"
                                  Content="Restart after install if required"
                                  IsChecked="{Binding RestartAfterInstallIfRequired, Mode=TwoWay}" />
                        <CheckBox Margin="0,5,0,0"
                                  VerticalAlignment="Center"
                                  Content="Auto refresh status"
                                  IsChecked="{Binding IsInstallStatusAutoRefreshEnabled, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSectionIndex}" Value="2">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE81C;" Content="Load Update History" Command="{Binding LoadUpdateHistoryCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSectionIndex}" Value="3">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Width="34"
                                MinWidth="34"
                                Height="30"
                                Padding="0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Content="{Binding MonitoringToggleIconGlyph}"
                                ToolTip="{Binding MonitoringToggleToolTip}"
                                IsEnabled="{Binding IsMonitoringToggleEnabled}"
                                Command="{Binding ToggleMonitoringCommand}" />
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE72C;" Content="Reload Log" Command="{Binding ReloadMonitoringCommand}" />
                        <TextBlock Margin="8,4,6,0" VerticalAlignment="Center" Text="Tail lines:" FontWeight="Bold" />
                        <TextBox Width="80"
                                 Margin="0,0,8,8"
                                VerticalContentAlignment="Center"
                                Text="{Binding TailLineCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSectionIndex}" Value="4">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8B7;" Content="Load Current Host" Command="{Binding RefreshUsoDiagnosticsCommand}" />
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8E5;" Content="Open Local File" Command="{Binding BrowseUsoDatabaseCommand}" />
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8A5;" Content="Export Current View" Command="{Binding ExportCurrentUsoViewCommand}" />
                        <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE8C8;" Content="Copy Selected Row" Command="{Binding CopySelectedUsoRowCommand}" />
                        <TextBlock Margin="8,4,6,0" VerticalAlignment="Center" Text="Source" FontWeight="Bold" />
                        <TextBox Width="520"
                                 Margin="0,0,8,8"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Text="{Binding UsoDiagnosticsSourceText}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#3D4F65"
                                   Text="{Binding UsoDiagnosticsStatus}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="2"
                        Margin="8"
                        SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TabControl}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="8">
                                        <ContentPresenter ContentSource="SelectedContent" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Style>
                <TabItem Header="Overview">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="Device Update Ring">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Windows Autopatch ring"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AutopatchRingText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         VerticalAlignment="Center"
                                         TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="Quick Log Tail" Margin="0,8,0,0">
                            <DataGrid ItemsSource="{Binding Entries}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="165" />
                                    <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70" />
                                    <DataGridTextColumn Header="Agent Event" Binding="{Binding AgentEvent}" Width="220" />
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
                                    <DataGridTemplateColumn Header="Message"
                                                            Width="420"
                                                            ClipboardContentBinding="{Binding Message}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}"
                                                           TextWrapping="Wrap"
                                                           ToolTip="{Binding MessageToolTip}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasMessageToolTip}" Value="True">
                                                                    <Setter Property="Foreground" Value="#1E5AA5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Row="2"
                                  Margin="0,8,0,0"
                                  Header="Registered Update Providers">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="180" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,0,6"
                                           Foreground="#3D4F65"
                                           TextWrapping="Wrap"
                                           Text="{Binding RegisteredUpdateProvidersInfo}" />
                                <Border Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Padding="8"
                                        BorderBrush="#D7E3F4"
                                        BorderThickness="1"
                                        Background="#F7F9FC">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12"
                                                Height="12"
                                                Margin="0,2,8,0"
                                                CornerRadius="6"
                                                Background="{Binding RegisteredUpdateProvidersHealthColorHex}" />
                                        <TextBlock Text="{Binding RegisteredUpdateProvidersHealthText}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding RegisteredUpdateProvidersHealthSummaryText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding RegisteredUpdateProviders}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Service ID" Binding="{Binding ServiceId}" Width="320" />
                                        <DataGridCheckBoxColumn Header="Default"
                                                                Binding="{Binding IsDefault, Mode=OneWay}"
                                                                Width="75"
                                                                IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Header="Registered"
                                                                Binding="{Binding IsRegisteredWithAutomaticUpdates, Mode=OneWay}"
                                                                Width="95"
                                                                IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Header="Offers WU"
                                                                Binding="{Binding OffersWindowsUpdates, Mode=OneWay}"
                                                                Width="90"
                                                                IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Header="Managed"
                                                                Binding="{Binding IsManaged, Mode=OneWay}"
                                                                Width="80"
                                                                IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Available Updates">
                    <Grid>
                        <GroupBox Header="Available Updates">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Margin="0,0,0,8"
                                        Padding="8"
                                        BorderBrush="#CCD6E3"
                                        BorderThickness="1"
                                        Background="#F6FAFF">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding LastAvailableUpdatesScanInfo}" />
                                        <StackPanel Margin="0,6,0,0"
                                                    Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstallTaskRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding InstallTaskStatusText}" />
                                            <ProgressBar Width="140"
                                                         Height="8"
                                                         Margin="8,0,8,0"
                                                         VerticalAlignment="Center"
                                                         IsIndeterminate="True" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding InstallTaskPhaseText}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="#3D4F65"
                                                   Text="{Binding InstallTaskDetail}" />
                                    </StackPanel>
                                </Border>

                                <TabControl Grid.Row="1"
                                            SelectedIndex="{Binding SelectedAvailableUpdatesViewIndex, Mode=TwoWay}">
                                    <TabItem Header="Available Updates">
                                        <Grid>
                                            <DataGrid IsReadOnly="False"
                                                      SelectionUnit="FullRow"
                                                      ItemsSource="{Binding VisibleAvailableUpdates}">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Select" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox HorizontalAlignment="Center"
                                                                          Focusable="False"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                    <CheckBox.Style>
                                                                        <Style TargetType="CheckBox">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </CheckBox.Style>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Title"
                                                                        Binding="{Binding Title}"
                                                                        Width="SizeToCells"
                                                                        MinWidth="320"
                                                                        IsReadOnly="True" />
                                                    <DataGridTextColumn Header="KB" Binding="{Binding KbArticles}" Width="140" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Categories" Binding="{Binding Categories}" Width="190" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="150" IsReadOnly="True" />
                                                    <DataGridTemplateColumn Header="Downloaded" Width="95" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style BasedOn="{StaticResource UpdateStateIconStyle}" TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                                                    <Setter Property="Text" Value="✔" />
                                                                                    <Setter Property="Foreground" Value="#0E8A16" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsDownloaded}" Value="False">
                                                                                    <Setter Property="Text" Value="✖" />
                                                                                    <Setter Property="Foreground" Value="#C42B1C" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Installed" Width="85" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style BasedOn="{StaticResource UpdateStateIconStyle}" TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                    <Setter Property="Text" Value="✔" />
                                                                                    <Setter Property="Foreground" Value="#0E8A16" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                                    <Setter Property="Text" Value="✖" />
                                                                                    <Setter Property="Foreground" Value="#C42B1C" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridCheckBoxColumn Header="Mandatory"
                                                                            Binding="{Binding IsMandatory, Mode=OneWay}"
                                                                            Width="80"
                                                                            IsReadOnly="True" />
                                                    <DataGridCheckBoxColumn Header="Hidden"
                                                                            Binding="{Binding IsHidden, Mode=OneWay}"
                                                                            Width="70"
                                                                            IsReadOnly="True" />
                                                    <DataGridCheckBoxColumn Header="EULA"
                                                                            Binding="{Binding EulaAccepted, Mode=OneWay}"
                                                                            Width="70"
                                                                            IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Update ID" Binding="{Binding UpdateId}" Width="220" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="55" IsReadOnly="True" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Border Background="#99FFFFFF">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUpdateBusy}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ProgressBar Width="220" Height="10" IsIndeterminate="True" />
                                                    <TextBlock Margin="0,10,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="Loading updates..." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="All Updates">
                                        <Grid>
                                            <DataGrid IsReadOnly="False"
                                                      SelectionUnit="FullRow"
                                                      ItemsSource="{Binding VisibleAvailableUpdates}">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Select" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox HorizontalAlignment="Center"
                                                                          Focusable="False"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                    <CheckBox.Style>
                                                                        <Style TargetType="CheckBox">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </CheckBox.Style>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Title"
                                                                        Binding="{Binding Title}"
                                                                        Width="SizeToCells"
                                                                        MinWidth="320"
                                                                        IsReadOnly="True" />
                                                    <DataGridTextColumn Header="KB" Binding="{Binding KbArticles}" Width="140" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Categories" Binding="{Binding Categories}" Width="190" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="150" IsReadOnly="True" />
                                                    <DataGridTemplateColumn Header="Downloaded" Width="95" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style BasedOn="{StaticResource UpdateStateIconStyle}" TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                                                    <Setter Property="Text" Value="✔" />
                                                                                    <Setter Property="Foreground" Value="#0E8A16" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsDownloaded}" Value="False">
                                                                                    <Setter Property="Text" Value="✖" />
                                                                                    <Setter Property="Foreground" Value="#C42B1C" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Installed" Width="85" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style BasedOn="{StaticResource UpdateStateIconStyle}" TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                    <Setter Property="Text" Value="✔" />
                                                                                    <Setter Property="Foreground" Value="#0E8A16" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                                    <Setter Property="Text" Value="✖" />
                                                                                    <Setter Property="Foreground" Value="#C42B1C" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridCheckBoxColumn Header="Mandatory"
                                                                            Binding="{Binding IsMandatory, Mode=OneWay}"
                                                                            Width="80"
                                                                            IsReadOnly="True" />
                                                    <DataGridCheckBoxColumn Header="Hidden"
                                                                            Binding="{Binding IsHidden, Mode=OneWay}"
                                                                            Width="70"
                                                                            IsReadOnly="True" />
                                                    <DataGridCheckBoxColumn Header="EULA"
                                                                            Binding="{Binding EulaAccepted, Mode=OneWay}"
                                                                            Width="70"
                                                                            IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Update ID" Binding="{Binding UpdateId}" Width="220" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="55" IsReadOnly="True" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Border Background="#99FFFFFF">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUpdateBusy}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ProgressBar Width="220" Height="10" IsIndeterminate="True" />
                                                    <TextBlock Margin="0,10,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="Loading updates..." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Installation Log">
                                        <ListBox ItemsSource="{Binding InstallProgressEntries}"
                                                 PreviewKeyDown="InstallProgressList_OnPreviewKeyDown"
                                                 SelectionMode="Extended"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}"
                                                               TextWrapping="NoWrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="ToolTip" Value="{x:Null}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasErrorDescription}" Value="True">
                                                                        <Setter Property="ToolTip" Value="{Binding ErrorDescription}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>
                                </TabControl>

                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Update History">
                    <Grid>
                        <GroupBox Header="Update History">
                            <DataGrid x:Name="UpdateHistoryGrid" ItemsSource="{Binding UpdateHistoryEntries}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Attempt uninstall"
                                                              Command="{Binding PlacementTarget.Tag.TryUninstallHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="145" />
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="115" />
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="140" />
                                    <DataGridTextColumn Header="HResult" Binding="{Binding HResult}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style BasedOn="{StaticResource ResolvedCodeTextStyle}" TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding HResultDescription}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Update ID" Binding="{Binding UpdateId}" Width="220" />
                                    <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="55" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="ReportingEvents.log">
                    <Grid>
                        <GroupBox Header="Live ReportingEvents.log">
                            <Grid>
                                <DataGrid x:Name="EventsGrid"
                                          ItemsSource="{Binding Entries}"
                                          LoadingRow="EventsGrid_OnLoadingRow"
                                          MouseDoubleClick="EventsGrid_OnMouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time"
                                                            Binding="{Binding TimestampDisplay}"
                                                            SortMemberPath="TimestampSortKey"
                                                            Width="145" />
                                        <DataGridTextColumn Header="Agent Event" Binding="{Binding AgentEvent}" Width="200" />
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
                                        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="110" />
                                        <DataGridTemplateColumn Header="Message"
                                                                Width="520"
                                                                ClipboardContentBinding="{Binding Message}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Message}"
                                                               TextWrapping="Wrap"
                                                               ToolTip="{Binding MessageToolTip}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasMessageToolTip}" Value="True">
                                                                        <Setter Property="Foreground" Value="#1E5AA5" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="75" />
                                        <DataGridTextColumn Header="Update ID" Binding="{Binding UpdateId}" Width="220" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Visibility="{Binding IsReportingEventsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Background="#CCF7FAFF"
                                        BorderBrush="#9DB7D7"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ProgressBar Width="240"
                                                     Height="8"
                                                     IsIndeterminate="True"
                                                     Margin="0,0,0,10" />
                                        <TextBlock Text="{Binding ReportingEventsLoadingText}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2D3D"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="USO Diagnostics">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="0,0,0,8"
                                Padding="10"
                                BorderBrush="#CCD6E3"
                                BorderThickness="1"
                                Background="#F6FAFF">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding UsoDashboardAttentionSummary}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#3D4F65"
                                           Text="{Binding UsoRebootSummaryText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TabControl Grid.Row="1"
                                    SelectedIndex="{Binding SelectedUsoDiagnosticsTabIndex, Mode=TwoWay}">
                            <TabItem Header="Overview Dashboard">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="0,0,4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <ItemsControl ItemsSource="{Binding UsoDashboardCards}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="280"
                                                            Margin="0,0,10,10"
                                                            Padding="10"
                                                            BorderBrush="#D8E1EF"
                                                            BorderThickness="1"
                                                            Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{Binding AccentBrush}" />
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                <TextBlock Foreground="#4B5565"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding Title}" />
                                                                <TextBlock Margin="0,6,0,4"
                                                                           FontSize="16"
                                                                           FontWeight="Bold"
                                                                           Text="{Binding Value}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Foreground="#4B5565"
                                                                           Text="{Binding Detail}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <GroupBox Grid.Row="1" Header="Overview Notes">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="This dashboard combines VARIABLE state, provider scan health, current reboot-sensitive update lifecycle, and scheduler/deadline markers. Any interpretation beyond the raw fields is labeled as heuristic." />
                                        </GroupBox>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Reboot Timeline">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Margin="0,4,6,0"
                                                   VerticalAlignment="Center"
                                                   Text="Filter"
                                                   FontWeight="Bold" />
                                        <TextBox Width="320"
                                                 Margin="0,0,8,0"
                                                 Text="{Binding RebootTimelineSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>

                                    <TabControl Grid.Row="1"
                                                SelectedIndex="{Binding SelectedRebootTimelineSubTabIndex, Mode=TwoWay}">
                                        <TabItem Header="Chronological Timeline">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DataGrid Grid.Row="0"
                                                          ItemsSource="{Binding VisibleRebootTimelineEvents}"
                                                          SelectedItem="{Binding SelectedRebootTimelineEvent, Mode=TwoWay}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="150" />
                                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130" />
                                                        <DataGridTextColumn Header="Type" Binding="{Binding EventType}" Width="140" />
                                                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                                        <DataGridTextColumn Header="Update" Binding="{Binding AssociatedUpdateTitle}" Width="280" />
                                                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceText}" Width="90" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <GroupBox Grid.Row="1" Header="Selected Timeline Event" Margin="0,8,0,0">
                                                    <TextBox BorderThickness="0"
                                                             Background="Transparent"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"
                                                             Text="{Binding SelectedRebootTimelineEvent.Details}" />
                                                </GroupBox>
                                            </Grid>
                                        </TabItem>

                                        <TabItem Header="Reboot History">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DataGrid Grid.Row="0"
                                                          ItemsSource="{Binding VisibleRebootHistoryRecords}"
                                                          SelectedItem="{Binding SelectedRebootHistoryRecord, Mode=TwoWay}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="145" />
                                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="110" />
                                                        <DataGridTextColumn Header="Recognition Time" Binding="{Binding RecognitionTime}" Width="145" />
                                                        <DataGridTextColumn Header="Scheduled Time" Binding="{Binding ScheduledTime}" Width="145" />
                                                        <DataGridTextColumn Header="Actual Reboot Time" Binding="{Binding ActualRebootTime}" Width="145" />
                                                        <DataGridTextColumn Header="Associated Update" Binding="{Binding AssociatedUpdateTitle}" Width="*" />
                                                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceText}" Width="90" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <GroupBox Grid.Row="1" Header="Reboot History Notes" Margin="0,8,0,0">
                                                    <TextBox BorderThickness="0"
                                                             Background="Transparent"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"
                                                             Text="{Binding SelectedRebootHistoryRecord.Notes}" />
                                                </GroupBox>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Scan Diagnostics">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Margin="0,4,6,0" Text="Filter" FontWeight="Bold" />
                                        <TextBox Width="320"
                                                 Text="{Binding ScanDiagnosticsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding VisibleProviderScanStatuses}"
                                              SelectedItem="{Binding SelectedProviderScanStatus, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ProviderId" Binding="{Binding ProviderId}" Width="140" />
                                            <DataGridTextColumn Header="ScanAttemptTime" Binding="{Binding ScanAttemptTimeDisplay}" Width="145">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding ScanAttemptTimeRaw}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ScanTime" Binding="{Binding ScanTimeDisplay}" Width="145">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding ScanTimeRaw}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ScanError" Binding="{Binding ScanErrorRaw}" Width="110" />
                                            <DataGridTextColumn Header="ScanErrorTime" Binding="{Binding ScanErrorTimeDisplay}" Width="145">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding ScanErrorTimeRaw}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ScanErrorInteractive" Binding="{Binding ScanErrorInteractiveRaw}" Width="120" />
                                            <DataGridTextColumn Header="FailuresSinceLastSuccess" Binding="{Binding ScanFailuresSinceLastSuccessRaw}" Width="140" />
                                            <DataGridTextColumn Header="ScanSummaryTime" Binding="{Binding ScanSummaryTimeDisplay}" Width="145">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding ScanSummaryTimeRaw}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ScanTags" Binding="{Binding ScanTags}" Width="90" />
                                            <DataGridTextColumn Header="LastScanStatus" Binding="{Binding LastScanStatus}" Width="130" />
                                            <DataGridCheckBoxColumn Header="Attention" Binding="{Binding AttentionRequired}" Width="80" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GroupBox Grid.Row="2" Header="Heuristic Explanation" Margin="0,8,0,0">
                                        <TextBox BorderThickness="0"
                                                 Background="Transparent"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding SelectedProviderScanStatus.HeuristicExplanation}" />
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Update Lifecycle">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Margin="0,4,6,0" Text="Filter" FontWeight="Bold" />
                                        <TextBox Width="320"
                                                 Text="{Binding UpdateLifecycleSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding VisibleUpdateLifecycleRecords}"
                                              SelectedItem="{Binding SelectedUpdateLifecycleRecord, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ProviderId" Binding="{Binding ProviderId}" Width="110" />
                                            <DataGridTextColumn Header="UpdateId" Binding="{Binding UpdateId}" Width="220" />
                                            <DataGridTextColumn Header="Resolved Title" Binding="{Binding Title}" Width="260" />
                                            <DataGridTextColumn Header="StateSummary" Binding="{Binding StateSummary}" Width="170" />
                                            <DataGridTextColumn Header="ProbableInstallDeadline" Binding="{Binding ProbableInstallDeadline}" Width="155" />
                                            <DataGridTextColumn Header="ProbableRebootDeadline" Binding="{Binding ProbableRebootDeadline}" Width="155" />
                                            <DataGridTextColumn Header="DeadlineConfidence" Binding="{Binding DeadlineConfidenceText}" Width="210" />
                                            <DataGridTextColumn Header="UpdateBlock" Binding="{Binding UpdateBlock}" Width="160" />
                                            <DataGridTextColumn Header="LastUpdateBlock" Binding="{Binding LastUpdateBlock}" Width="160" />
                                            <DataGridTextColumn Header="RebootRequiredTime" Binding="{Binding RebootRequiredTime}" Width="140" />
                                            <DataGridTextColumn Header="RebootRecognitionTime" Binding="{Binding RebootRecognitionTime}" Width="150" />
                                            <DataGridTextColumn Header="TitleSource" Binding="{Binding ResolvedTitleSource}" Width="170" />
                                            <DataGridTextColumn Header="Category" Binding="{Binding HistoryCategory}" Width="90" />
                                            <DataGridTextColumn Header="CompletedTime" Binding="{Binding CompletedTime}" Width="130" />
                                            <DataGridCheckBoxColumn Header="RebootRequired" Binding="{Binding WasRebootRequired}" Width="95" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GroupBox Grid.Row="2" Header="Selected Update Details" Margin="0,8,0,0">
                                        <TabControl Height="190">
                                            <TabItem Header="Deadline">
                                                <TextBox BorderThickness="0"
                                                         Background="Transparent"
                                                         IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding SelectedUpdateLifecycleRecord.DeadlineExplanation}" />
                                            </TabItem>
                                            <TabItem Header="Important UPDATESPROP">
                                                <TextBox BorderThickness="0"
                                                         Background="Transparent"
                                                         IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         TextWrapping="NoWrap"
                                                         Text="{Binding SelectedUpdateLifecycleRecord.ImportantUpdateProperties}" />
                                            </TabItem>
                                            <TabItem Header="Raw UPDATESPROP">
                                                <TextBox BorderThickness="0"
                                                         Background="Transparent"
                                                         FontFamily="Consolas"
                                                         FontSize="11"
                                                         IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         TextWrapping="NoWrap"
                                                         Text="{Binding SelectedUpdateLifecycleRecord.RawUpdatePropertiesJson}" />
                                            </TabItem>
                                            <TabItem Header="COMPLETEDUPDATES Metadata">
                                                <TextBox BorderThickness="0"
                                                         Background="Transparent"
                                                         FontFamily="Consolas"
                                                         FontSize="11"
                                                         IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding SelectedUpdateLifecycleRecord.Metadata}" />
                                            </TabItem>
                                        </TabControl>
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Downtime Estimation">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Margin="0,4,6,0" Text="Filter" FontWeight="Bold" />
                                        <TextBox Width="320"
                                                 Text="{Binding DowntimeSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding VisibleDowntimeEstimateRecords}"
                                              SelectedItem="{Binding SelectedDowntimeEstimateRecord, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="145" />
                                            <DataGridTextColumn Header="Estimated Low" Binding="{Binding EstimatedTimeMinutes}" Width="95" />
                                            <DataGridTextColumn Header="Estimated High" Binding="{Binding EstimatedTimeHighMinutes}" Width="95" />
                                            <DataGridTextColumn Header="ActualLabel" Binding="{Binding ActualLabel}" Width="85" />
                                            <DataGridTextColumn Header="ActualSeconds" Binding="{Binding ActualSeconds}" Width="90" />
                                            <DataGridTextColumn Header="Composition" Binding="{Binding LikelyUpdateComposition}" Width="280" />
                                            <DataGridTextColumn Header="EstimateVsActualSummary" Binding="{Binding EstimateVsActualSummary}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GroupBox Grid.Row="2" Header="Raw Metadata JSON" Margin="0,8,0,0">
                                        <TextBox BorderThickness="0"
                                                 Background="Transparent"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding SelectedDowntimeEstimateRecord.RawMetadataJson}" />
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Variable Dictionary">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Margin="0,4,6,0" Text="Filter" FontWeight="Bold" />
                                        <TextBox Width="320"
                                                 Text="{Binding VariableDictionarySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding VisibleVariableExplanationRecords}"
                                              SelectedItem="{Binding SelectedVariableExplanationRecord, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="240" />
                                            <DataGridTextColumn Header="RawValue" Binding="{Binding RawValue}" Width="140" />
                                            <DataGridTextColumn Header="ParsedValue" Binding="{Binding ParsedValue}" Width="150" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="150" />
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                                            <DataGridTextColumn Header="SuggestedMeaning" Binding="{Binding SuggestedMeaning}" Width="240" />
                                            <DataGridTextColumn Header="SuggestedEffect" Binding="{Binding SuggestedEffect}" Width="240" />
                                            <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceText}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GroupBox Grid.Row="2" Header="Explanation Notes" Margin="0,8,0,0">
