                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     Text="{Binding SelectedVariableExplanationRecord.Notes}" />
                                            <TextBox Margin="0,4,0,0"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     Text="{Binding SelectedVariableExplanationRecord.CorrelatedEvents}" />
                                        </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Raw Data Inspector">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Margin="0,4,6,0" Text="Table" FontWeight="Bold" />
                                        <ComboBox Width="260"
                                                  Margin="0,0,10,0"
                                                  ItemsSource="{Binding UsoRawTables}"
                                                  SelectedItem="{Binding SelectedUsoRawTable, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" />
                                        <TextBlock DockPanel.Dock="Left" Margin="0,4,6,0" Text="Filter" FontWeight="Bold" />
                                        <TextBox Width="320"
                                                 Margin="0,0,10,0"
                                                 Text="{Binding RawInspectorFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="#3D4F65"
                                                   Text="{Binding RawInspectorStatusText}" />
                                    </DockPanel>
                                        <DataGrid Grid.Row="1"
                                                  AutoGenerateColumns="True"
                                                  SelectionUnit="FullRow"
                                                  ItemsSource="{Binding UsoRawTableView}"
                                                  SelectedItem="{Binding SelectedRawInspectorRow, Mode=TwoWay}" />
                                </Grid>
                            </TabItem>

                            <TabItem Header="UPDATESPROP">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Margin="0,4,6,0" Text="Filter" FontWeight="Bold" />
                                        <TextBox Width="320"
                                                 Text="{Binding UpdatePropertiesSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding VisibleUpdatePropertiesRecords}"
                                              SelectedItem="{Binding SelectedUpdatePropertiesRecord, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ProviderId" Binding="{Binding ProviderId}" Width="110" />
                                            <DataGridTextColumn Header="UpdateId" Binding="{Binding UpdateId}" Width="220" />
                                            <DataGridTextColumn Header="Resolved Title" Binding="{Binding Title}" Width="260" />
                                            <DataGridTextColumn Header="StateSummary" Binding="{Binding StateSummary}" Width="170" />
                                            <DataGridTextColumn Header="Scheduling" Binding="{Binding SchedulingSummary}" Width="260" />
                                            <DataGridTextColumn Header="Queue" Binding="{Binding QueueNumberDisplay}" Width="70" />
                                            <DataGridTextColumn Header="DownloadSize" Binding="{Binding DownloadSizeDisplay}" Width="105" />
                                            <DataGridTextColumn Header="IPU" Binding="{Binding IsIpuDisplay}" Width="65" />
                                            <DataGridTextColumn Header="WorkBit" Binding="{Binding WorkBitDisplay}" Width="70" />
                                            <DataGridTextColumn Header="ProbableInstallDeadline" Binding="{Binding ProbableInstallDeadline}" Width="155" />
                                            <DataGridTextColumn Header="ProbableRebootDeadline" Binding="{Binding ProbableRebootDeadline}" Width="155" />
                                            <DataGridTextColumn Header="DeadlineConfidence" Binding="{Binding DeadlineConfidenceText}" Width="210" />
                                            <DataGridTextColumn Header="DelayCount" Binding="{Binding UpdateActionDelayCount}" Width="85" />
                                            <DataGridTextColumn Header="DelayTime" Binding="{Binding UpdateActionDelayTime}" Width="145" />
                                            <DataGridTextColumn Header="BlockSummary" Binding="{Binding UpdateBlockSummary}" Width="190" />
                                            <DataGridTextColumn Header="TitleSource" Binding="{Binding ResolvedTitleSource}" Width="170" />
                                            <DataGridTextColumn Header="UpdateBlock" Binding="{Binding UpdateBlock}" Width="160" />
                                            <DataGridTextColumn Header="LastUpdateBlock" Binding="{Binding LastUpdateBlock}" Width="160" />
                                            <DataGridTextColumn Header="RebootRequiredTime" Binding="{Binding RebootRequiredTime}" Width="140" />
                                            <DataGridTextColumn Header="RebootRecognitionTime" Binding="{Binding RebootRecognitionTime}" Width="150" />
                                            <DataGridTextColumn Header="CorrelationVector" Binding="{Binding CorrelationVector}" Width="160" />
                                            <DataGridTextColumn Header="ActionTags" Binding="{Binding ActionTagsSummary}" Width="190" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GroupBox Grid.Row="2" Header="UPDATESPROP Details" Margin="0,8,0,0">
                                        <TabControl Height="190">
                                            <TabItem Header="Scheduling">
                                                <TextBox BorderThickness="0"
                                                         Background="Transparent"
                                                         IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding SelectedUpdatePropertiesRecord.SchedulingDetails}" />
                                            </TabItem>
                                            <TabItem Header="Deadline">
                                                <TextBox BorderThickness="0"
                                                         Background="Transparent"
                                                         IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding SelectedUpdatePropertiesRecord.DeadlineExplanation}" />
                                            </TabItem>
                                            <TabItem Header="Important UPDATESPROP">
                                                <TextBox BorderThickness="0"
                                                         Background="Transparent"
                                                         IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         TextWrapping="NoWrap"
                                                         Text="{Binding SelectedUpdatePropertiesRecord.ImportantUpdateProperties}" />
                                            </TabItem>
                                            <TabItem Header="Raw UPDATESPROP">
                                                <TextBox BorderThickness="0"
                                                         Background="Transparent"
                                                         FontFamily="Consolas"
                                                         FontSize="11"
                                                         IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         TextWrapping="NoWrap"
                                                         Text="{Binding SelectedUpdatePropertiesRecord.RawUpdatePropertiesJson}" />
                                            </TabItem>
                                            <TabItem Header="COMPLETEDUPDATES Metadata">
                                                <TextBox BorderThickness="0"
                                                         Background="Transparent"
                                                         FontFamily="Consolas"
                                                         FontSize="11"
                                                         IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding SelectedUpdatePropertiesRecord.Metadata}" />
                                            </TabItem>
                                        </TabControl>
                                    </GroupBox>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
