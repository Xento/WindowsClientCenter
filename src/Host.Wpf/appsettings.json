{
  "Runtime": {
    "Environment": "dev"
  },
  "Diagnostics": {
    "VerboseOperations": false
  },
  "Defender": {
    "SecurityIntelligenceWarningThresholdHours": 36,
    "SecurityIntelligenceCriticalThresholdHours": 72
  },
  "Intune": {
    "Mode": "Mock",
    "DemoHostName": "DEMO-CLIENT-01",
    "DemoTenantId": "demo.example",
    "DemoUserPrincipalName": "alex.wilson@demo.example",
    "DemoConnectedUsersText": "DEMO\\alex.wilson, DEMO\\helpdesk.ops",
    "Proxy": "",
    "PowerShellSessionPoolSize": 5,
    "MecmBackend": "ClientCenterLib",
    "TenantId": "",
    "ClientId": "",
    "RedirectUri": "http://localhost",
    "VpnAdapterDescriptionMatch": "",
    "VpnProviderName": ""
  },
  "Explorer": {
    "Targets": [
      {
        "Name": "Remote Shares",
        "Type": "Group",
        "Children": [
          {
            "Name": "Remote C$",
            "Path": "\\\\%HOSTNAME%\\c$",
            "IsDefault": true
          },
          {
            "Name": "Remote Admin$",
            "Path": "\\\\%HOSTNAME%\\admin$"
          }
        ]
      },
      {
        "Name": "Local",
        "Type": "Group",
        "Children": [
          {
            "Name": "Local Program Files",
            "Path": "C:\\Program Files"
          }
        ]
      },
      {
        "Name": "MECM",
        "Type": "Folder",
        "Children": [
          {
            "Name": "CCM Logs",
            "Path": "\\\\%HOSTNAME%\\c$\\Windows\\CCM\\Logs"
          },
          {
            "Name": "CCM Cache",
            "Path": "\\\\%HOSTNAME%\\c$\\Windows\\CCMCache"
          },
          {
            "Name": "CCMSetup Logs",
            "Path": "\\\\%HOSTNAME%\\c$\\Windows\\CCMSetup\\Logs"
          }
        ]
      },
      {
        "Name": "Windows",
        "Type": "Group",
        "Children": [
          {
            "Name": "C$",
            "Path": "\\\\%HOSTNAME%\\c$",
            "IsDefault": true
          },
          {
            "Name": "Windows Temp",
            "Path": "\\\\%HOSTNAME%\\c$\\Windows\\Temp"
          },
          {
            "Name": "Users",
            "Path": "\\\\%HOSTNAME%\\c$\\Users"
          },
          {
            "Name": "ProgramData",
            "Path": "\\\\%HOSTNAME%\\c$\\ProgramData"
          }
        ]
      }
    ]
  },
  "Plugins": {
    "NativeDirectory": "plugins/native",
    "Settings": {
      "device-overview": {
        "cloudDevice": {
          "enabled": true,
          "showDevice": true,
          "showPlatform": true,
          "showCompliance": true,
          "showCloudLastSync": true,
          "showMdmLastSync": true,
          "showImeLastSync": true,
          "showIntuneStatus": true
        },
        "localSystem": {
          "enabled": true,
          "showManufacturer": true,
          "showModel": true,
          "showSerialNumber": true,
          "showWindowsVersion": true,
          "showWindowsBuild": true,
          "showUpdateRing": true,
          "showPatchStatus": true,
          "showFreeDiskSpace": true,
          "freeDiskSpaceWarningGb": 20,
          "freeDiskSpaceCriticalGb": 10
        },
        "platformSecurity": {
          "enabled": true,
          "showBitLocker": true,
          "showBitLockerDetail": true,
          "showTpm": true,
          "showTpmVersion": true,
          "showTpmDetail": true,
          "showSecureBoot": true,
          "showCredentialGuard": true,
          "showVbs": true,
          "showMemoryIntegrity": true
        },
        "systemRuntime": {
          "enabled": true,
          "showUptime": true,
          "showLastReboot": true,
          "showInstallDate": true,
          "showPendingReboot": true,
          "showPendingRebootDetail": true,
          "showWindowsUpdateRestart": true,
          "showScheduledRestartTime": true,
          "showSessionLock": true,
          "showLockedSince": true,
          "uptimeWarningDays": 14,
          "uptimeCriticalDays": 30
        },
        "network": {
          "enabled": true,
          "showConnectionType": true,
          "showActiveAdapter": true,
          "showWifiSsid": true,
          "showVpn": true,
          "showVpnProvider": true
        },
        "clientHealth": {
          "enabled": true,
          "showOverallHealth": true,
          "showSummary": true,
          "checks": {
            "defender": {
              "enabled": true,
              "showStatus": true,
              "showDetail": true,
              "showDefinitionAge": true,
              "signatureWarningHours": 36,
              "signatureCriticalHours": 72,
              "scanWarningDays": 14
            },
            "entraJoin": {
              "enabled": true,
              "showStatus": true
            },
            "adJoin": {
              "enabled": true,
              "showStatus": true
            },
            "intuneEnrollment": {
              "enabled": true,
              "showStatus": true
            },
            "enrollmentUrls": {
              "enabled": true
            },
            "freeDiskSpace": {
              "enabled": true
            },
            "uptime": {
              "enabled": true
            }
          }
        },
        "deliveryOptimization": {
          "enabled": true,
          "showSummary": true,
          "showActiveJobs": true,
          "showCurrentMetrics": true,
          "showMonthlyMetrics": true,
          "showPeerSnapshot": true,
          "showConfiguration": true,
          "showSourceDistribution": true,
          "showTransferTimeline": true,
          "showNotes": true
        }
      },
      "device-services-view": {
        "filters": [
          {
            "displayName": "All services",
            "includeAllServices": true
          },
          {
            "displayName": "MECM / Intune related",
            "serviceNames": "CcmExec, ccmsetup, CmRcService, smstsmgr, IntuneManagementExtension, dmwappushservice, BITS, DoSvc"
          },
          {
            "displayName": "Windows Update",
            "serviceNames": "wuauserv, BITS, DoSvc, WaaSMedicSvc, UsoSvc"
          }
        ]
      },
      "device-processes-view": {
        "defaultViewMode": "list",
        "refreshIntervals": "0,5,10,30,60",
        "defaultRefreshIntervalSeconds": 0
      },
      "powershell-scripts": {
        "scriptDirectory": "PSScripts"
      }
    }
  }
}
