<UserControl x:Class="WindowsClientCenter.Plugins.DeviceActions.UI.DeviceAppxApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SelectableValueTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppReadOnlyTextBoxStyle}" />
        <Style TargetType="Button" BasedOn="{StaticResource AppCommandButtonStyle}" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGridStyle}">
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="260" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE72C;" Content="Refresh" Width="105" Command="{Binding RefreshCommand}" />
            <TextBox Grid.Column="1" Margin="8,0" Text="{Binding PackageFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter package name or full name" />
            <CheckBox Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Content="Frameworks" IsChecked="{Binding ShowFrameworks}" />
            <CheckBox Grid.Column="3" Margin="8,0" VerticalAlignment="Center" Content="Resources" IsChecked="{Binding ShowResources}" />
            <CheckBox Grid.Column="4" Margin="8,0" VerticalAlignment="Center" Content="Optional" IsChecked="{Binding ShowOptional}" />
            <CheckBox Grid.Column="5" Margin="8,0" VerticalAlignment="Center" Content="System / non-removable" IsChecked="{Binding ShowNonRemovable}" />
            <TextBlock Grid.Column="7" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ActiveUserText, StringFormat=Active user: {0}}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="460" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Application" Binding="{Binding EffectiveDisplayName}" Width="220" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
                    <DataGridTextColumn Header="Type" Binding="{Binding PackageType}" Width="90" />
                    <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="95" />
                    <DataGridTextColumn Header="Provisioned" Binding="{Binding ProvisionedDisplay}" Width="90" />
                    <DataGridTextColumn Header="Removable" Binding="{Binding RemovableDisplay}" Width="85" />
                    <DataGridTextColumn Header="Package full name" Binding="{Binding PackageFullName}" Width="360" />
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Margin="6,0,0,7" FontWeight="SemiBold" Text="User registration status" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedPackage.Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="170" />
                        <DataGridTextColumn Header="SID" Binding="{Binding UserSid}" Width="230" />
                        <DataGridTextColumn Header="State" Binding="{Binding InstallState}" Width="100" />
                        <DataGridTextColumn Header="Active" Binding="{Binding ActiveUserDisplay}" Width="65" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button Style="{StaticResource AppDangerIconTextButtonStyle}" Tag="&#xE74D;" Content="Remove user" Width="125" Command="{Binding RemoveForSelectedUserCommand}" />
                    <Button Style="{StaticResource AppDangerIconTextButtonStyle}" Tag="&#xE74D;" Content="Remove all users" Width="150" Command="{Binding RemoveForAllUsersCommand}" />
                    <Button Style="{StaticResource AppDangerIconTextButtonStyle}" Tag="&#xE74D;" Content="Remove provisioning" Width="175" Command="{Binding RemoveProvisioningCommand}" />
                    <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE8D4;" Content="Register active user" Width="165" Command="{Binding RegisterForActiveUserCommand}" />
                </WrapPanel>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <GroupBox Grid.Row="3" Header="WinGet catalog (winget and Microsoft Store)">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding WingetQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter a package name or exact ID" />
                    <ComboBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding WingetSources}" SelectedItem="{Binding WingetSourceFilter}" />
                    <Button Grid.Column="2" Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE721;" Content="Search" Width="105" Command="{Binding SearchWingetCommand}" />
                </Grid>
                <DataGrid Grid.Row="1" Margin="0,8" ItemsSource="{Binding WingetResults}" SelectedItem="{Binding SelectedWingetResult, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280" />
                        <DataGridTextColumn Header="Exact ID" Binding="{Binding Id}" Width="280" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Grid.Row="2">
                    <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE896;" Content="Install machine" Width="140" Command="{Binding InstallMachineCommand}" />
                    <Button Style="{StaticResource AppPrimaryIconTextButtonStyle}" Tag="&#xE896;" Content="Install active user" Width="155" Command="{Binding InstallForActiveUserCommand}" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE895;" Content="Update machine" Width="140" Command="{Binding UpgradeMachineCommand}" />
                    <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE895;" Content="Update active user" Width="155" Command="{Binding UpgradeForActiveUserCommand}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" Text="Machine scope requests --scope machine; it does not register the app for every existing user." />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <TextBox Grid.Row="4" Margin="0,10,0,0" Text="{Binding Status}" Style="{StaticResource SelectableValueTextBoxStyle}" />
    </Grid>
</UserControl>
