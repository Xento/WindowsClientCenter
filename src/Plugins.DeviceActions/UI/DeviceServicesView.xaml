<UserControl x:Class="WindowsClientCenter.Plugins.DeviceActions.UI.DeviceServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SelectableValueTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource AppReadOnlyTextBoxStyle}" />
        <Style TargetType="Button" BasedOn="{StaticResource AppCommandButtonStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource AppCommandComboBoxStyle}" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGridStyle}">
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Margin="0,0,0,10">
            <Button Style="{StaticResource AppIconTextButtonStyle}" Tag="&#xE72C;" Content="Refresh" Width="110" Command="{Binding RefreshCommand}" />
        </WrapPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="View" FontWeight="SemiBold" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" Text="Start mode" FontWeight="SemiBold" />
            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding StartModeOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedStartModeOption, Mode=TwoWay}" />
        </Grid>

        <DataGrid Grid.Row="2"
                  PreviewMouseRightButtonDown="ServicesGrid_OnPreviewMouseRightButtonDown"
                  ItemsSource="{Binding Services}"
                  SelectedItem="{Binding SelectedService, Mode=TwoWay}">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Start"
                              Command="{Binding PlacementTarget.DataContext.StartSelectedServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Stop"
                              Command="{Binding PlacementTarget.DataContext.StopSelectedServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Restart"
                              Command="{Binding PlacementTarget.DataContext.RestartSelectedServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Kill"
                              Command="{Binding PlacementTarget.DataContext.KillSelectedServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="Apply selected start mode"
                              Command="{Binding PlacementTarget.DataContext.ApplySelectedStartModeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="250" />
                <DataGridTextColumn Header="Name" Binding="{Binding ServiceName}" Width="180" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
                <DataGridTextColumn Header="Start Mode" Binding="{Binding StartModeDisplay}" Width="180" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBox Grid.Row="3"
                 Margin="0,10,0,0"
                 Text="{Binding Status}"
                 Style="{StaticResource SelectableValueTextBoxStyle}" />
    </Grid>
</UserControl>
