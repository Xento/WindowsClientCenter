<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Modified by Windows Client Center contributors in 2026 from the upstream
    .NET Framework project at commit 1c875c00ab04144741247873cea1b69cb25ef1ea.
    Licensed under LGPL-3.0-or-later. See LICENSE.md and MODIFICATIONS.md.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>sccmclictr.automation</AssemblyName>
    <RootNamespace>sccmclictr.automation</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Preserve upstream warnings without allowing repository-wide
         -warnaserror to turn known legacy diagnostics into build failures. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0108;CS0168;CS1570;CS1587;CS8073;CS8632;CS8981;SYSLIB0014;SYSLIB0021</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="9.0.8" />
    <PackageReference Include="System.Runtime.Caching" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\HealthCheck.ps.txt">
      <WithCulture>false</WithCulture>
      <LogicalName>sccmclictr.automation.Resources.HealthCheck.ps.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
