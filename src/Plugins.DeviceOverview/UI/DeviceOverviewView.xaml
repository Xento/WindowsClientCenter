                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Scheduled Restart Time" FontWeight="Bold" Visibility="{Binding ShowSystemRuntimeScheduledRestartTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="6" Grid.Column="1"
                                                 Text="{Binding LocalSnapshot.SystemRuntime.WindowsUpdateScheduledRestartTimeText, TargetNullValue=Windows Update scheduled restart state is not available., FallbackValue=Windows Update scheduled restart state is not available.}"
