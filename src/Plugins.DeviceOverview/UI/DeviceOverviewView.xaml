                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Session Lock" FontWeight="Bold" Visibility="{Binding ShowSystemRuntimeSessionLock, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowSystemRuntimeSessionLock, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource StatusDotStyle}"
                                                    Tag="{Binding LocalSnapshot.SystemRuntime.SessionLockStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                            <TextBox Text="{Binding LocalSnapshot.SystemRuntime.SessionLockStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Locked Since" FontWeight="Bold" Visibility="{Binding ShowSystemRuntimeLockedSince, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="8" Grid.Column="1"
                                                 Text="{Binding LocalSnapshot.SystemRuntime.SessionLockedSinceText, TargetNullValue=Session lock state is not available., FallbackValue=Session lock state is not available.}"
                                                 Style="{StaticResource SelectableValueTextBoxStyle}"
                                                 Visibility="{Binding ShowSystemRuntimeLockedSince, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>

                                    <Border Style="{StaticResource GroupLoadingOverlayStyle}"
