                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Active Adapter" FontWeight="Bold" Visibility="{Binding ShowNetworkActiveAdapter, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LocalSnapshot.NetworkConnectivity.PrimaryAdapterText, TargetNullValue=Unknown, FallbackValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowNetworkActiveAdapter, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Wi-Fi SSID" FontWeight="Bold" Visibility="{Binding ShowNetworkWifiSsid, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LocalSnapshot.NetworkConnectivity.WiFiSsidText, TargetNullValue=Not connected, FallbackValue=Not connected}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowNetworkWifiSsid, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="VPN" FontWeight="Bold" Visibility="{Binding ShowNetworkVpn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowNetworkVpn, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource StatusDotStyle}"
                                                    Tag="{Binding LocalSnapshot.NetworkConnectivity.VpnStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                            <TextBox Text="{Binding LocalSnapshot.NetworkConnectivity.VpnStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="VPN Provider" FontWeight="Bold" Visibility="{Binding ShowNetworkVpnProvider, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LocalSnapshot.NetworkConnectivity.VpnProviderText, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowNetworkVpnProvider, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Port Authentication" FontWeight="Bold" Visibility="{Binding ShowNetworkPortAuthenticationSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal"
                                                    ToolTip="{Binding LocalSnapshot.NetworkConnectivity.PortAuthenticationDetailText, TargetNullValue=Port authentication status is not available., FallbackValue=Port authentication status is not available.}"
                                                    Visibility="{Binding ShowNetworkPortAuthenticationSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource StatusDotStyle}"
                                                    Tag="{Binding LocalSnapshot.NetworkConnectivity.PortAuthenticationStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                            <TextBox Text="{Binding LocalSnapshot.NetworkConnectivity.PortAuthenticationStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource GroupLoadingOverlayStyle}"
                                            Visibility="{Binding IsNetworkLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Loading network..."
                                                       HorizontalAlignment="Center"
                                                       Foreground="#4A5A70"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <ProgressBar Width="160" Height="6" IsIndeterminate="True" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Client Health Check" Grid.Row="2" Grid.Column="1" Margin="8,0,0,8" Padding="8"
                                      Visibility="{Binding IsClientHealthVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Overall Health" FontWeight="Bold" Visibility="{Binding ShowClientHealthOverall, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowClientHealthOverall, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Width="12" Height="12" CornerRadius="6" Margin="0,3,6,0" Background="{Binding ClientHealthColorHex}" />
                                            <TextBox Text="{Binding ClientHealthStatusText}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Summary" FontWeight="Bold" Visibility="{Binding ShowClientHealthSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClientHealthSummaryText}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowClientHealthSummary, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Defender" FontWeight="Bold" Visibility="{Binding ShowDefenderHealth, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" ToolTip="{Binding DefenderHealthDetailText}" Visibility="{Binding ShowDefenderHealth, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Width="12" Height="12" CornerRadius="6" Margin="0,3,6,0" Background="{Binding DefenderHealthColorHex}" />
                                            <TextBox Text="{Binding DefenderHealthStatusText}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Defender Detail" FontWeight="Bold" Visibility="{Binding ShowDefenderHealthDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DefenderHealthSummaryText}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowDefenderHealthDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Definition Age" FontWeight="Bold" Visibility="{Binding ShowDefenderDefinitionAge, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DefenderDefinitionAgeText}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowDefenderDefinitionAge, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Entra Joined" FontWeight="Bold" Visibility="{Binding ShowEntraJoinHealth, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" ToolTip="{Binding EntraJoinDetailText}" Visibility="{Binding ShowEntraJoinHealth, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Width="12" Height="12" CornerRadius="6" Margin="0,3,6,0" Background="{Binding EntraJoinColorHex}" />
                                            <TextBox Text="{Binding EntraJoinStatusText}" Style="{StaticResource SelectableValueTextBoxStyle}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="AD Joined" FontWeight="Bold" Visibility="{Binding ShowAdJoinHealth, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" ToolTip="{Binding AdJoinDetailText}" Visibility="{Binding ShowAdJoinHealth, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Width="12" Height="12" CornerRadius="6" Margin="0,3,6,0" Background="{Binding AdJoinColorHex}" />
                                            <TextBox Text="{Binding AdJoinStatusText}" Style="{StaticResource SelectableValueTextBoxStyle}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Intune Enrolled" FontWeight="Bold" Visibility="{Binding ShowIntuneEnrollmentHealth, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" ToolTip="{Binding IntuneEnrollmentDetailText}" Visibility="{Binding ShowIntuneEnrollmentHealth, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Width="12" Height="12" CornerRadius="6" Margin="0,3,6,0" Background="{Binding IntuneEnrollmentColorHex}" />
                                            <TextBox Text="{Binding IntuneEnrollmentStatusText}" Style="{StaticResource SelectableValueTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource GroupLoadingOverlayStyle}"
                                            Visibility="{Binding IsClientHealthLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Loading health checks..."
                                                       HorizontalAlignment="Center"
                                                       Foreground="#4A5A70"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <ProgressBar Width="160" Height="6" IsIndeterminate="True" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </GroupBox>
                        </Grid>

                        <TextBox Margin="0,2,0,0" Text="{Binding Status}" Style="{StaticResource SelectableValueTextBoxStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Delivery Optimization"
                     Visibility="{Binding IsDeliveryOptimizationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Time range" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="190"
                                      ItemsSource="{Binding DeliveryOptimizationRangeOptions}"
                                      SelectedItem="{Binding SelectedDeliveryOptimizationRange, Mode=TwoWay}"
                                      IsEnabled="{Binding IsDeliveryOptimizationRangeFilterEnabled}" />
                            <TextBlock Margin="12,2,0,0"
                                       Text="{Binding DeliveryOptimizationRangeHint}"
                                       Foreground="#4A5A70"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8"
                                    Visibility="{Binding ShowDeliveryOptimizationSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding DeliveryOptimizationSummaryText}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding DeliveryOptimizationWindowText, StringFormat='Data window: {0}'}"
                                       Foreground="#4A5A70" />
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.ColumnSpan="2" Header="Active Jobs" Margin="0,0,0,8" Padding="8"
                                      Visibility="{Binding ShowDeliveryOptimizationActiveJobs, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeliveryOptimizationActiveJobsSummaryText}"
                                               Margin="0,0,0,6"
                                               Foreground="#4A5A70"
                                               TextWrapping="Wrap" />
                                    <DataGrid ItemsSource="{Binding DeliveryOptimizationActiveJobs}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Height="210">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Content" Binding="{Binding Content}" Width="*" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding FileSizeText}" Width="100" />
                                            <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadedText}" Width="110" />
                                            <DataGridTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="90" />
                                            <DataGridTextColumn Header="Speed" Binding="{Binding DownloadRateText}" Width="100" />
                                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="240" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Header="Current Perf Snapshot" Margin="0,0,8,8" Padding="8"
                                      Visibility="{Binding ShowDeliveryOptimizationCurrentMetrics, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeliveryOptimizationCurrentMetricsSummaryText}"
                                               Margin="0,0,0,6"
                                               Foreground="#4A5A70"
                                               TextWrapping="Wrap" />
                                    <DataGrid ItemsSource="{Binding DeliveryOptimizationCurrentMetrics}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Height="210">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Metric" Binding="{Binding Name}" Width="220" />
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Grid.Column="1" Header="Month To Date Perf Snapshot" Margin="8,0,0,8" Padding="8"
                                      Visibility="{Binding ShowDeliveryOptimizationMonthlyMetrics, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeliveryOptimizationMonthlyMetricsSummaryText}"
                                               Margin="0,0,0,6"
                                               Foreground="#4A5A70"
                                               TextWrapping="Wrap" />
                                    <DataGrid ItemsSource="{Binding DeliveryOptimizationMonthlyMetrics}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Height="210">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Metric" Binding="{Binding Name}" Width="220" />
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Row="2" Header="Peer Snapshot" Margin="0,0,8,8" Padding="8"
                                      Visibility="{Binding ShowDeliveryOptimizationPeerSnapshot, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeliveryOptimizationPeerSummaryText}"
                                               Margin="0,0,0,6"
                                               Foreground="#4A5A70"
                                               TextWrapping="Wrap" />
                                    <DataGrid ItemsSource="{Binding DeliveryOptimizationPeerStatuses}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Height="210">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Content" Binding="{Binding Content}" Width="*" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                                            <DataGridTextColumn Header="Candidates" Binding="{Binding CandidateCount}" Width="80" />
                                            <DataGridTextColumn Header="Connected" Binding="{Binding ConnectedPeerCount}" Width="80" />
                                            <DataGridTextColumn Header="Peer MB" Binding="{Binding BytesFromPeersText}" Width="100" />
                                            <DataGridTextColumn Header="HTTP MB" Binding="{Binding BytesFromHttpText}" Width="100" />
                                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="220" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Row="2" Grid.Column="1" Header="Configuration" Margin="8,0,0,8" Padding="8"
                                      Visibility="{Binding ShowDeliveryOptimizationConfiguration, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeliveryOptimizationConfigurationSummaryText}"
                                               Margin="0,0,0,6"
                                               Foreground="#4A5A70"
                                               TextWrapping="Wrap" />
                                    <DataGrid ItemsSource="{Binding DeliveryOptimizationConfigurationRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Height="210">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Setting" Binding="{Binding Name}" Width="220" />
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Source Distribution" Margin="0,0,8,8" Padding="8"
                                      Visibility="{Binding ShowDeliveryOptimizationSourceDistribution, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid ItemsSource="{Binding DeliveryOptimizationSourceRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Height="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                                        <DataGridTextColumn Header="Bytes" Binding="{Binding BytesText}" Width="120" />
                                        <DataGridTextColumn Header="Transfers" Binding="{Binding TransferCount}" Width="80" />
                                        <DataGridTemplateColumn Header="Share" Width="190">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="56" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Grid.Column="0"
                                                                     Height="14"
                                                                     Margin="0,2,6,2"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding SharePercent}" />
                                                        <TextBlock Grid.Column="1"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   Text="{Binding ShareText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Grid.Column="1" Header="Transfer Timeline" Margin="8,0,0,8" Padding="8"
                                      Visibility="{Binding ShowDeliveryOptimizationTransferTimeline, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid ItemsSource="{Binding DeliveryOptimizationTransfers}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Height="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Timestamp (UTC)"
                                                            Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                            Width="170" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120" />
                                        <DataGridTextColumn Header="MB" Binding="{Binding BytesText}" Width="110" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>

                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding DeliveryOptimizationNotesText, StringFormat='Notes: {0}'}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowDeliveryOptimizationNotes, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Port Authentication"
                     Visibility="{Binding IsPortAuthenticationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8"
                                   Visibility="{Binding ShowPortAuthenticationRemediation, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Style="{StaticResource AppIconTextButtonStyle}"
                                    Tag="&#xE72C;"
                                    Content="Refresh"
                                    Margin="0,0,8,8"
                                    MinWidth="118"
                                    Command="{Binding RefreshPortAuthenticationCommand}"
                                    IsEnabled="{Binding CanRefreshPortAuthentication}" />
                            <Button Style="{StaticResource AppIconTextButtonStyle}"
                                    Tag="&#xE117;"
                                    Content="Restart 802.1X Services"
                                    Margin="0,0,8,8"
                                    MinWidth="180"
                                    Command="{Binding RestartPortAuthenticationServicesCommand}"
                                    IsEnabled="{Binding CanRestartPortAuthenticationServices}" />
                            <Button Style="{StaticResource AppIconTextButtonStyle}"
                                    Tag="&#xE7AD;"
                                    Content="Restart Adapter"
                                    Margin="0,0,8,8"
                                    MinWidth="135"
                                    Command="{Binding RestartPortAuthenticationAdapterCommand}"
                                    IsEnabled="{Binding CanRestartPortAuthenticationAdapter}" />
                            <Button Style="{StaticResource AppIconTextButtonStyle}"
                                    Tag="&#xE7E8;"
                                    Content="Enable Tracing"
                                    Margin="0,0,8,8"
                                    MinWidth="130"
                                    Command="{Binding EnablePortAuthenticationTracingCommand}"
                                    IsEnabled="{Binding CanEnablePortAuthenticationTracing}" />
                            <Button Style="{StaticResource AppIconTextButtonStyle}"
                                    Tag="&#xE711;"
                                    Content="Disable Tracing"
                                    Margin="0,0,8,8"
                                    MinWidth="130"
                                    Command="{Binding DisablePortAuthenticationTracingCommand}"
                                    IsEnabled="{Binding CanDisablePortAuthenticationTracing}" />
                            <Button Style="{StaticResource AppIconTextButtonStyle}"
                                    Tag="&#xE8D4;"
                                    Content="Enable Autoconfig"
                                    Margin="0,0,8,8"
                                    MinWidth="150"
                                    Command="{Binding EnablePortAuthenticationAutoconfigCommand}"
                                    IsEnabled="{Binding CanEnablePortAuthenticationAutoconfig}" />
                            <ComboBox Width="240"
                                      Margin="0,0,8,8"
                                      ItemsSource="{Binding PortAuthenticationSnapshot.Profiles}"
                                      SelectedItem="{Binding SelectedPortAuthenticationProfile, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding HasPortAuthenticationProfiles}" />
                            <Button Style="{StaticResource AppIconTextButtonStyle}"
                                    Tag="&#xE72D;"
                                    Content="Reapply Profile"
                                    Margin="0,0,8,8"
                                    MinWidth="140"
                                    Command="{Binding ReapplyPortAuthenticationProfileCommand}"
                                    IsEnabled="{Binding CanReapplyPortAuthenticationProfile}" />
                            <CheckBox Margin="0,6,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding ConfirmPortAuthenticationDisruptiveActions, Mode=TwoWay}"
                                      Content="Confirm disruptive actions (adapter restart/profile reapply)." />
                        </WrapPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding PortAuthenticationSectionStatusText}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding PortAuthenticationActionStatusText}"
                                       Foreground="#4A5A70"
                                       TextWrapping="Wrap" />
                            <ProgressBar Margin="0,8,0,0"
                                         Height="6"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsPortAuthenticationLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <GroupBox Header="Summary"
                                  Margin="0,0,0,8"
                                  Padding="8"
                                  Visibility="{Binding ShowPortAuthenticationSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Overall Status" FontWeight="Bold" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <Border Style="{StaticResource StatusLevelDotStyle}"
                                            Tag="{Binding PortAuthenticationOverallStatusLevel}" />
                                    <TextBox Text="{Binding PortAuthenticationOverallStatusText, Mode=OneWay}"
                                             Style="{StaticResource SelectableValueTextBoxStyle}"
                                             FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Applicability" FontWeight="Bold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PortAuthenticationApplicabilityText, Mode=OneWay}" Style="{StaticResource SelectableValueTextBoxStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="FQDN" FontWeight="Bold" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PortAuthenticationFqdnText, Mode=OneWay}" Style="{StaticResource SelectableValueTextBoxStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Active Interface" FontWeight="Bold" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PortAuthenticationActiveInterfaceName, Mode=OneWay}" Style="{StaticResource SelectableValueTextBoxStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Adapter Detail" FontWeight="Bold" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PortAuthenticationActiveInterfaceDescription, Mode=OneWay}" Style="{StaticResource SelectableValueTextBoxStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Authentication State" FontWeight="Bold" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PortAuthenticationAuthenticationStateText, Mode=OneWay}" Style="{StaticResource SelectableValueTextBoxStyle}" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Tracing / Last Success" FontWeight="Bold" />
                                <StackPanel Grid.Row="6" Grid.Column="1">
                                    <TextBox Text="{Binding PortAuthenticationTracingModeText, Mode=OneWay, StringFormat='Tracing: {0}'}"
                                             Style="{StaticResource SelectableValueTextBoxStyle}" />
                                    <TextBox Margin="0,4,0,0"
                                             Text="{Binding PortAuthenticationLastSuccessfulAuthenticationText, Mode=OneWay}"
                                             Style="{StaticResource SelectableValueTextBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <TextBlock Margin="0,0,0,8"
                                   Text="{Binding PortAuthenticationOverallDetailText}"
                                   Foreground="#4A5A70"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowPortAuthenticationSummary, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <GroupBox Header="Checks"
                                  Margin="0,0,0,8"
                                  Padding="8"
                                  Visibility="{Binding ShowPortAuthenticationChecks, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid ItemsSource="{Binding PortAuthenticationSnapshot.Checks}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="220">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusLevelDotStyle}"
                                                        Tag="{Binding StatusLevel}"
                                                        HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="140" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Profiles"
                                  Margin="0,0,0,8"
                                  Padding="8"
                                  Visibility="{Binding ShowPortAuthenticationProfiles, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid ItemsSource="{Binding PortAuthenticationSnapshot.Profiles}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="220">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusLevelDotStyle}"
                                                        Tag="{Binding StatusLevel}"
                                                        HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="220" />
                                    <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="160" />
                                    <DataGridTextColumn Header="AuthMode" Binding="{Binding AuthMode}" Width="120" />
                                    <DataGridTextColumn Header="SSO" Binding="{Binding SsoMode}" Width="120" />
                                    <DataGridTextColumn Header="OneX Enabled" Binding="{Binding OneXEnabledText}" Width="110" />
                                    <DataGridTextColumn Header="OneX Enforced" Binding="{Binding OneXEnforcedText}" Width="110" />
                                    <DataGridTextColumn Header="EAP" Binding="{Binding EapType}" Width="110" />
                                    <DataGridTextColumn Header="Parse Status" Binding="{Binding ParseStatusText}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Certificates"
                                  Margin="0,0,0,8"
                                  Padding="8"
                                  Visibility="{Binding ShowPortAuthenticationCertificates, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid ItemsSource="{Binding PortAuthenticationSnapshot.Certificates}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="240">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusLevelDotStyle}"
                                                        Tag="{Binding StatusLevel}"
                                                        HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="240" />
                                    <DataGridTextColumn Header="SAN DNS" Binding="{Binding SanDns}" Width="200" />
                                    <DataGridTextColumn Header="FQDN Match" Binding="{Binding FqdnMatchText}" Width="95" />
                                    <DataGridTextColumn Header="Private Key" Binding="{Binding HasPrivateKeyText}" Width="90" />
                                    <DataGridTextColumn Header="Validity" Binding="{Binding ValidityText}" Width="150" />
                                    <DataGridTextColumn Header="Chain Status" Binding="{Binding ChainStatusText}" Width="180" />
                                    <DataGridTextColumn Header="Issuer" Binding="{Binding Issuer}" Width="220" />
                                    <DataGridTextColumn Header="Store" Binding="{Binding StoreName}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Events"
                                  Margin="0,0,0,8"
                                  Padding="8"
                                  Visibility="{Binding ShowPortAuthenticationEvents, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid ItemsSource="{Binding PortAuthenticationSnapshot.Events}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="280">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusLevelDotStyle}"
                                                        Tag="{Binding StatusLevel}"
                                                        HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Time (UTC)"
                                                        Binding="{Binding TimeCreated, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                        Width="170" />
                                    <DataGridTextColumn Header="Log" Binding="{Binding LogName}" Width="240" />
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="260" />
                                    <DataGridTextColumn Header="Recommended Action" Binding="{Binding RecommendedAction}" Width="260" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
