<UserControl x:Class="WindowsClientCenter.Plugins.DeviceOverview.UI.DeviceOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="PatchStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3D4F65" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LocalSnapshot.PatchStatusLevel}" Value="Green">
                    <Setter Property="Foreground" Value="#1E7A36" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocalSnapshot.PatchStatusLevel}" Value="Yellow">
                    <Setter Property="Foreground" Value="#A66A00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocalSnapshot.PatchStatusLevel}" Value="Red">
                    <Setter Property="Foreground" Value="#9A1D1D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectableValueTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource AppReadOnlyTextBoxStyle}" />

        <Style x:Key="SelectablePatchStatusTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource SelectableValueTextBoxStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PatchStatusDotStyle"
               TargetType="Border"
               BasedOn="{StaticResource AppStatusDotStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LocalSnapshot.PatchStatusLevel}" Value="Green">
                    <Setter Property="Background" Value="{StaticResource ShellSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocalSnapshot.PatchStatusLevel}" Value="Yellow">
                    <Setter Property="Background" Value="{StaticResource ShellWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocalSnapshot.PatchStatusLevel}" Value="Red">
                    <Setter Property="Background" Value="{StaticResource ShellDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FreeDiskSpaceStatusTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource SelectableValueTextBoxStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FreeDiskSpaceStatusDotStyle"
               TargetType="Border"
               BasedOn="{StaticResource AppStatusDotStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FreeDiskSpaceStatusLevel}" Value="Green">
                    <Setter Property="Background" Value="{StaticResource ShellSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FreeDiskSpaceStatusLevel}" Value="Yellow">
                    <Setter Property="Background" Value="{StaticResource ShellWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FreeDiskSpaceStatusLevel}" Value="Red">
                    <Setter Property="Background" Value="{StaticResource ShellDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UptimeStatusTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource SelectableValueTextBoxStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="UptimeStatusDotStyle"
               TargetType="Border"
               BasedOn="{StaticResource AppStatusDotStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UptimeStatusLevel}" Value="Green">
                    <Setter Property="Background" Value="{StaticResource ShellSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding UptimeStatusLevel}" Value="Yellow">
                    <Setter Property="Background" Value="{StaticResource ShellWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding UptimeStatusLevel}" Value="Red">
                    <Setter Property="Background" Value="{StaticResource ShellDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Border" BasedOn="{StaticResource AppStatusDotStyle}" />

        <Style x:Key="StatusLevelDotStyle"
               TargetType="Border"
               BasedOn="{StaticResource AppStatusDotStyle}">
            <Setter Property="Background" Value="#8A8A8A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Green">
                    <Setter Property="Background" Value="{StaticResource ShellSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Yellow">
                    <Setter Property="Background" Value="{StaticResource ShellWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Red">
                    <Setter Property="Background" Value="{StaticResource ShellDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGridStyle}">
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="GroupBox" BasedOn="{StaticResource AppGroupBoxStyle}" />
        <Style x:Key="GroupLoadingOverlayStyle" TargetType="Border" BasedOn="{StaticResource AppLoadingOverlayStyle}" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource AppIconTextButtonStyle}"
                    Tag="&#xE72C;"
                    Content="Refresh"
                    Width="120"
                    Command="{Binding RefreshCommand}" />
        </StackPanel>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">
            <TabControl.Style>
                <Style TargetType="TabControl">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabControl}">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="8">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Style>

            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <GroupBox Header="Cloud Device" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="8"
                                      Visibility="{Binding IsCloudDeviceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Device" FontWeight="Bold" Visibility="{Binding ShowCloudDeviceName, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Device.DeviceName, TargetNullValue=Not found}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowCloudDeviceName, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Platform" FontWeight="Bold" Visibility="{Binding ShowCloudDevicePlatform, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Device.Platform, TargetNullValue=-}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowCloudDevicePlatform, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Compliance" FontWeight="Bold" Visibility="{Binding ShowCloudDeviceCompliance, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Device.ComplianceState, TargetNullValue=-}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowCloudDeviceCompliance, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Sync (Cloud)" FontWeight="Bold" Visibility="{Binding ShowCloudDeviceCloudLastSync, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Device.LastSync, TargetNullValue=-}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowCloudDeviceCloudLastSync, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Last Sync (MDM)" FontWeight="Bold" Visibility="{Binding ShowCloudDeviceMdmLastSync, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LocalSnapshot.MdmLastSyncText, TargetNullValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowCloudDeviceMdmLastSync, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Last Sync (IME)" FontWeight="Bold" Visibility="{Binding ShowCloudDeviceImeLastSync, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LocalSnapshot.ImeLastSyncText, TargetNullValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowCloudDeviceImeLastSync, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Intune Status" FontWeight="Bold" Visibility="{Binding ShowCloudDeviceIntuneStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="6" Grid.Column="1" Visibility="{Binding ShowCloudDeviceIntuneStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding EnrollmentUrlsDetailText}">
                                                <Border Width="12" Height="12" CornerRadius="6" Margin="0,3,6,0" Background="{Binding EnrollmentUrlsColorHex}" />
                                                <TextBox Text="{Binding EnrollmentUrlsStatusText}" Style="{StaticResource SelectableValueTextBoxStyle}" />
                                            </StackPanel>
                                            <TextBlock Margin="18,2,0,0" Text="{Binding EnrollmentUrlsDetailText}" Foreground="#4A5A70" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource GroupLoadingOverlayStyle}"
                                            Visibility="{Binding IsCloudDeviceLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Loading cloud device..."
                                                       HorizontalAlignment="Center"
                                                       Foreground="#4A5A70"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <ProgressBar Width="160" Height="6" IsIndeterminate="True" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Local System" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="8"
                                      Visibility="{Binding IsLocalSystemVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer" FontWeight="Bold" Visibility="{Binding ShowLocalSystemManufacturer, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LocalSnapshot.ManufacturerText, TargetNullValue=Unknown, FallbackValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowLocalSystemManufacturer, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" FontWeight="Bold" Visibility="{Binding ShowLocalSystemModel, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LocalSnapshot.ModelText, TargetNullValue=Unknown, FallbackValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowLocalSystemModel, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial Number" FontWeight="Bold" Visibility="{Binding ShowLocalSystemSerialNumber, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LocalSnapshot.SerialNumberText, TargetNullValue=Unknown, FallbackValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowLocalSystemSerialNumber, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Windows Version" FontWeight="Bold" Visibility="{Binding ShowLocalSystemWindowsVersion, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LocalSnapshot.WindowsVersionText, TargetNullValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowLocalSystemWindowsVersion, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Windows Build" FontWeight="Bold" Visibility="{Binding ShowLocalSystemWindowsBuild, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LocalSnapshot.WindowsBuildText, TargetNullValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowLocalSystemWindowsBuild, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Update Ring" FontWeight="Bold" Visibility="{Binding ShowLocalSystemUpdateRing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LocalSnapshot.UpdateRingText, TargetNullValue=Unknown, FallbackValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowLocalSystemUpdateRing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Patch Status" FontWeight="Bold" Visibility="{Binding ShowLocalSystemPatchStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowLocalSystemPatchStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource PatchStatusDotStyle}" />
                                            <TextBox Text="{Binding LocalSnapshot.PatchStatusText, TargetNullValue=Patch status unavailable.}"
                                                     Style="{StaticResource SelectablePatchStatusTextBoxStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Free Disk Space" FontWeight="Bold" Visibility="{Binding ShowLocalSystemFreeDiskSpace, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowLocalSystemFreeDiskSpace, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource FreeDiskSpaceStatusDotStyle}" />
                                            <TextBox Text="{Binding LocalSnapshot.FreeDiskSpaceText, TargetNullValue=Unknown}"
                                                     ToolTip="{Binding FreeDiskSpaceDetailText}"
                                                     Style="{StaticResource FreeDiskSpaceStatusTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource GroupLoadingOverlayStyle}"
                                            Visibility="{Binding IsLocalSystemLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Loading local system..."
                                                       HorizontalAlignment="Center"
                                                       Foreground="#4A5A70"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <ProgressBar Width="160" Height="6" IsIndeterminate="True" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Platform Security" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Padding="8"
                                      Visibility="{Binding IsPlatformSecurityVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="BitLocker" FontWeight="Bold" Visibility="{Binding ShowPlatformSecurityBitLocker, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowPlatformSecurityBitLocker, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource StatusDotStyle}"
                                                    Tag="{Binding LocalSnapshot.PlatformSecurity.BitLockerStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                            <TextBox Text="{Binding LocalSnapshot.PlatformSecurity.BitLockerStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="BitLocker Detail" FontWeight="Bold" Visibility="{Binding ShowPlatformSecurityBitLockerDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LocalSnapshot.PlatformSecurity.BitLockerDetailText, TargetNullValue=BitLocker status is not available., FallbackValue=BitLocker status is not available.}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowPlatformSecurityBitLockerDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="TPM" FontWeight="Bold" Visibility="{Binding ShowPlatformSecurityTpm, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowPlatformSecurityTpm, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource StatusDotStyle}"
                                                    Tag="{Binding LocalSnapshot.PlatformSecurity.TpmStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                            <TextBox Text="{Binding LocalSnapshot.PlatformSecurity.TpmStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="TPM Version" FontWeight="Bold" Visibility="{Binding ShowPlatformSecurityTpmVersion, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LocalSnapshot.PlatformSecurity.TpmVersionText, TargetNullValue=Unknown, FallbackValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowPlatformSecurityTpmVersion, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="TPM Detail" FontWeight="Bold" Visibility="{Binding ShowPlatformSecurityTpmDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LocalSnapshot.PlatformSecurity.TpmDetailText, TargetNullValue=TPM status is not available., FallbackValue=TPM status is not available.}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowPlatformSecurityTpmDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Secure Boot" FontWeight="Bold" Visibility="{Binding ShowPlatformSecuritySecureBoot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowPlatformSecuritySecureBoot, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource StatusDotStyle}"
                                                    Tag="{Binding LocalSnapshot.PlatformSecurity.SecureBootStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                            <TextBox Text="{Binding LocalSnapshot.PlatformSecurity.SecureBootStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Credential Guard" FontWeight="Bold" Visibility="{Binding ShowPlatformSecurityCredentialGuard, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowPlatformSecurityCredentialGuard, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource StatusDotStyle}"
                                                    Tag="{Binding LocalSnapshot.PlatformSecurity.CredentialGuardStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                            <TextBox Text="{Binding LocalSnapshot.PlatformSecurity.CredentialGuardStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="VBS" FontWeight="Bold" Visibility="{Binding ShowPlatformSecurityVbs, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowPlatformSecurityVbs, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource StatusDotStyle}"
                                                    Tag="{Binding LocalSnapshot.PlatformSecurity.VbsStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                            <TextBox Text="{Binding LocalSnapshot.PlatformSecurity.VbsStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Memory Integrity" FontWeight="Bold" Visibility="{Binding ShowPlatformSecurityMemoryIntegrity, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowPlatformSecurityMemoryIntegrity, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource StatusDotStyle}"
                                                    Tag="{Binding LocalSnapshot.PlatformSecurity.MemoryIntegrityStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                            <TextBox Text="{Binding LocalSnapshot.PlatformSecurity.MemoryIntegrityStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource GroupLoadingOverlayStyle}"
                                            Visibility="{Binding IsPlatformSecurityLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Loading platform security..."
                                                       HorizontalAlignment="Center"
                                                       Foreground="#4A5A70"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <ProgressBar Width="160" Height="6" IsIndeterminate="True" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="System Runtime" Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" Padding="8"
                                      Visibility="{Binding IsSystemRuntimeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Uptime" FontWeight="Bold" Visibility="{Binding ShowSystemRuntimeUptime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowSystemRuntimeUptime, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource UptimeStatusDotStyle}" />
                                            <TextBox Text="{Binding UptimeDisplayText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     ToolTip="{Binding UptimeDetailText}"
                                                     Style="{StaticResource UptimeStatusTextBoxStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Reboot" FontWeight="Bold" Visibility="{Binding ShowSystemRuntimeLastReboot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding LocalSnapshot.SystemRuntime.LastBootText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                 ToolTip="{Binding UptimeDetailText}"
                                                 Style="{StaticResource SelectableValueTextBoxStyle}"
                                                 Visibility="{Binding ShowSystemRuntimeLastReboot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Install Date" FontWeight="Bold" Visibility="{Binding ShowSystemRuntimeInstallDate, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LocalSnapshot.SystemRuntime.InstallDateText, TargetNullValue=Unknown, FallbackValue=Unknown}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowSystemRuntimeInstallDate, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pending Reboot" FontWeight="Bold" Visibility="{Binding ShowSystemRuntimePendingReboot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowSystemRuntimePendingReboot, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource StatusDotStyle}"
                                                    Tag="{Binding LocalSnapshot.SystemRuntime.PendingRebootStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                            <TextBox Text="{Binding LocalSnapshot.SystemRuntime.PendingRebootStatusText, TargetNullValue=Unknown, FallbackValue=Unknown}"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pending Reboot Detail" FontWeight="Bold" Visibility="{Binding ShowSystemRuntimePendingRebootDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LocalSnapshot.SystemRuntime.PendingRebootDetailText, TargetNullValue=Pending reboot state is not available., FallbackValue=Pending reboot state is not available.}" Style="{StaticResource SelectableValueTextBoxStyle}" Visibility="{Binding ShowSystemRuntimePendingRebootDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Windows Update Restart" FontWeight="Bold" Visibility="{Binding ShowSystemRuntimeWindowsUpdateRestart, Converter={StaticResource BoolToVisibilityConverter}}" />
